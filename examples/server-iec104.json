          "commonAddress": 1,
          "points": [
            {
              "address": 1,
              "kind": "yx",
              "wireType": 1,
              "name": "开关状态",
              "value": 0,
              "quality": 0
            },
            {
              "address": 16385,
              "kind": "yc",
              "wireType": 13,
              "name": "电压",
              "value": 220.5,
              "quality": 0
            }
          ],
          "dataTests": {
            "telemetry": {
              "stopOnDisconnect": false,
              "rules": [
                {
                  "enabled": true,
                  "kind": "yx",
                  "points": "1",
                  "intervalMs": 2000,
                  "mode": "toggle",
                  "min": 0,
                  "max": 1
                },
                {
                  "enabled": true,
                  "kind": "yc",
                  "points": "16385",
                  "intervalMs": 1000,
                  "mode": "report",
                  "cause": 1
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
